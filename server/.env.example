PORT=4000
# Required in production (16+ random chars): openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Origin of the frontend dev server (not needed when the built client is served by this server)
CORS_ORIGIN=http://localhost:5173
# SQLite file location
DATABASE_FILE=./data.sqlite
